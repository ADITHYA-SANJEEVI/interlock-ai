# No real credentials in this file. tools/pass0/bootstrap.py creates ignored role profiles.
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=acc_REPLACE
# Set once for a controlled merchant probe; never a general refund product endpoint.
ENABLE_REFUND_PROBES=false
# Local reference controls require explicit opt-in on API/broker/reference.
ENABLE_REFERENCE_CONTROLS=false
RUNTIME_MODE=LOCAL
# Comma-separated exact browser origins; empty disables cross-origin access.
CORS_ORIGINS=
