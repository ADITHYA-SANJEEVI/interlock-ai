# Copy to tmp/hackathon-private/paypal-us.env. Never place actual keys here.
# Dedicated app: Interlock AI US Sandbox (Merchant), bound to US Business account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant/Account ID of the NEW US Business sandbox account, not its email.
# Do not reuse the India merchant ID.
PAYPAL_MERCHANT_ID=
PAYPAL_SELLER_COUNTRY=US
PAYPAL_BUYER_COUNTRY=US
PAYPAL_CURRENCY=USD
PAYPAL_ACCOUNT_TYPE=BUSINESS
PAYPAL_APP_TYPE=MERCHANT
# Human confirmed the new app/account association in the Developer Dashboard.
PAYPAL_APP_BINDING_CONFIRMED=true
