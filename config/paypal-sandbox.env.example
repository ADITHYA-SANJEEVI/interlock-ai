# Copy to tmp/hackathon-private/paypal.env; never paste credentials into chat.
# Use Apps & Credentials > Sandbox, not Live. API origin is fixed in code.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional until the provider probe establishes the merchant binding.
PAYPAL_MERCHANT_ID=
# These describe the EXISTING sandbox accounts; they do not change countries.
PAYPAL_SELLER_COUNTRY=IN
PAYPAL_BUYER_COUNTRY=IN
