# Copy to tmp/hackathon-private/model.env. No PayPal/service credentials here.
# Providers: ollama (local /api/chat) or openai-compatible (/chat/completions).
MODEL_PROVIDER=ollama
MODEL_API_BASE=http://127.0.0.1:11434
MODEL_NAME=
MODEL_API_KEY=
MODEL_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# For a compatible remote server, use HTTPS and its explicit /v1 API base.
# Example shape: MODEL_API_BASE=https://your-model-host.example/v1

# Local evaluation must use a permitted endpoint. A personal subscription is not a public shared-use licence.
